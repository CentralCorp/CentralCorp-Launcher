{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conflictura Launcher",
  "version": "5.0.0",
  "identifier": "fr.centralcorp.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "Mise à jour",
        "url": "index.html",
        "width": 400,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": true
      },
      {
        "label": "main",
        "title": "Conflictura Launcher",
        "url": "launcher.html",
        "width": 1280,
        "height": 720,
        "minWidth": 980,
        "minHeight": 552,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
