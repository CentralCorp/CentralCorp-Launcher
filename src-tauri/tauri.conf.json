{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conflictura Launcher",
  "version": "5.0.0",
  "identifier": "fr.centralcorp.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "Mise à jour",
        "url": "index.html",
        "width": 400,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": true
      },
      {
        "label": "main",
        "title": "Conflictura Launcher",
        "url": "launcher.html",
        "width": 1280,
        "height": 720,
        "minWidth": 980,
        "minHeight": 552,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: https: http:; font-src 'self' data:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost tauri: http://tauri.localhost https://tauri.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
